# ───────────────────────────────────────────────────────────────────────────────
# ARCANA — variáveis de ambiente (lidas em src/ai/providers.ts, src/db/*, src/server/http.ts).
# Tudo é opcional em desenvolvimento: sem este ficheiro a aplicação corre com SQLite
# local e com o motor simbólico no lugar do modelo de linguagem.
# Copia para `.env` (não versionado) e ajusta.
# ───────────────────────────────────────────────────────────────────────────────

# Assinatura de sessões e do cookie CSRF. Em produção é obrigatória (32+ caracteres);
# fora de produção há um valor de desenvolvimento fixo com aviso no arranque.
ARCANA_SESSION_SECRET=troca-por-uma-cadeia-aleatoria-bem-longa
# AUTH_SECRET é aceite como alias de compatibilidade com hosts que já o definam.
# AUTH_SECRET=

# Base de dados. Sem DATABASE_URL: node:sqlite em var/arcana.db (WAL, migrações automáticas).
# DATABASE_URL=postgres://arcana:arcana@127.0.0.1:5432/arcana
# Caminho do SQLite (útil para testes paralelos e para o e2e).
# ARCANA_DB_PATH=var/arcana.db

# ── IA (endpoint compatível com /chat/completions) ────────────────────────────
# A chave vive só no processo do servidor; o navegador nunca a vê.
# ARCANA_AI_API_KEY=sk-...
# OPENAI_API_KEY / ANTHROPIC_API_KEY também são aceites (preferência explícita ganha).
# ARCANA_AI_PROVIDER=auto          # auto | openai | anthropic | local | …
# ARCANA_AI_BASE_URL=https://api.openai.com/v1
# ARCANA_AI_MODEL=gpt-4o-mini
# ARCANA_AI_TEMPERATURE=0.7
# ARCANA_AI_MAX_TOKENS=2048
# ARCANA_AI_TIMEOUT_MS=45000
# ARCANA_AI_JSON_MODE=1            # 1 força response_format=json_object
# ARCANA_AI_BURST_TOKENS=12000     # limitador por token-bucket
# ARCANA_AI_TOKENS_PER_MINUTE=24000

# Preços usados no orçamento diário por utilizador (USD por 1M de tokens).
# ARCANA_TOKEN_PRICES_USD='{"gpt-4o-mini":{"in":0.15,"out":0.6}}'
# 1 aceita `apiKey` no corpo dos pedidos — só para desenvolvimento/testes de contrato.
# ARCANA_ALLOW_BODY_KEY=0

# URL pública: links de partilha e Open Graph.
# ARCANA_PUBLIC_URL=http://localhost:3000
