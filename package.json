{
  "name": "arcana",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ARCANA — plataforma interativa de Tarot com interpretação contextual por IA, mesa cinematográfica e baralho completo de 78 cartas.",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:codespaces": "next dev -p 3000",
    "build": "npm run content:build && npm run art:build && next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "audit:content": "node scripts/audit-coverage.mjs",
    "audit:art": "node scripts/build-art.ts --check",
    "audit:tokens": "node scripts/audit-tokens.mjs",
    "audit:a11y": "node scripts/audit-a11y.mjs",
    "a11y:lighthouse": "node scripts/lighthouse.mjs",
    "bench": "node scripts/bench-engine.mjs",
    "content:build": "node scripts/build-content.ts",
    "art:build": "node scripts/build-art.ts",
    "db:migrate": "node --experimental-transform-types scripts/migrate.ts",
    "setup": "npm run content:build && npm run art:build && npm run db:migrate",
    "check": "npm run typecheck && npm run lint && npm run test && npm run audit:content && npm run audit:tokens && npm run audit:a11y",
    "verify": "npm run check && npm run build && npm run bench",
    "content:validate": "node scripts/build-content.ts --check && node scripts/build-art.ts --check"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "next": "^15.5.27",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "jsdom": "^30.1.2",
    "lighthouse": "^13.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22.6"
  }
}
